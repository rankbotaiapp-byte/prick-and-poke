import React, { useEffect, useState } from 'react';
import { supabase } from '../lib/supabase';
import ImageField from './ImageField';

const inputCls = 'w-full bg-zinc-900 border border-zinc-800 p-2 rounded-lg text-sm text-white focus:outline-none focus:border-white';
const labelCls = 'block text-xs uppercase tracking-wider text-zinc-400 mb-1';
const blank = { item_name: '', price: '', category: 'Food', description: '', image_url: '' };

export default function AdminMenuEditor({ businessSlug }) {
  const [items, setItems] = useState([]);
  const [form, setForm] = useState(null); // null = list view
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');

  const load = async () => {
    const { data } = await supabase.from('menu_items').select('*')
      .eq('business_slug', businessSlug).order('category').order('item_name');
    setItems(data || []);
  };
  useEffect(() => { load(); }, [businessSlug]);

  const save = async (e) => {
    e.preventDefault();
    setSaving(true);
    setError('');
    const row = {
      item_name: form.item_name.trim(),
      price: parseFloat(form.price),
      category: form.category,
      description: form.description,
      image_url: form.image_url || '',
      business_slug: businessSlug,
    };
    const { error: dbError } = form.id
      ? await supabase.from('menu_items').update(row).eq('id', form.id)
      : await supabase.from('menu_items').insert([row]);
    setSaving(false);
    if (dbError) { setError(dbError.message); return; }
    setForm(null);
    load();
  };

  const toggle = async (m) => {
    await supabase.from('menu_items').update({ available: m.available === false }).eq('id', m.id);
    load();
  };

  const remove = async (m) => {
    if (!window.confirm(`Delete ${m.item_name}?`)) return;
    await supabase.from('menu_items').delete().eq('id', m.id);
    load();
  };

  if (form) {
    return (
      <form onSubmit={save} className="p-6 bg-zinc-900 border border-zinc-800 rounded-2xl max-w-xl mx-auto my-6 space-y-4 text-white">
        <ImageField slug={businessSlug} folder="menu" value={form.image_url}
          onChange={(url) => setForm({ ...form, image_url: url })} label="Photo (square works best)" />
        <div>
          <label className={labelCls}>Name</label>
          <input className={inputCls} value={form.item_name} required
            onChange={(e) => setForm({ ...form, item_name: e.target.value })} />
        </div>
        <div className="grid grid-cols-2 gap-4">
          <div>
            <label className={labelCls}>Price ($)</label>
            <input type="number" step="0.01" className={inputCls} value={form.price} required
              onChange={(e) => setForm({ ...form, price: e.target.value })} />
          </div>
          <div>
            <label className={labelCls}>Category</label>
            <input className={inputCls} value={form.category} required placeholder="Food / Service"
              onChange={(e) => setForm({ ...form, category: e.target.value })} />
          </div>
        </div>
        <div>
          <label className={labelCls}>Description</label>
          <textarea className={inputCls} rows={3} value={form.description || ''}
            onChange={(e) => setForm({ ...form, description: e.target.value })} />
        </div>
        {error && <p className="text-sm text-rose-400">{error}</p>}
        <div className="flex gap-2">
          <button type="button" onClick={() => setForm(null)} className="flex-1 p-3 rounded-xl bg-zinc-800">Cancel</button>
          <button type="submit" disabled={saving} className="flex-1 p-3 rounded-xl bg-zinc-200 text-black font-semibold disabled:opacity-50">
            {saving ? 'Saving...' : 'Save'}
          </button>
        </div>
      </form>
    );
  }

  return (
    <div className="p-6 bg-zinc-900 border border-zinc-800 rounded-2xl max-w-xl mx-auto my-6 text-white space-y-3">
      {items.map((m) => (
        <div key={m.id} className="flex items-center gap-3 bg-zinc-950 border border-zinc-800 rounded-xl p-3">
          <div className="w-14 h-14 rounded-xl overflow-hidden bg-zinc-900 shrink-0">
            {m.image_url && <img src={m.image_url} alt="" className="w-full h-full object-cover" />}
          </div>
          <div className="flex-1 min-w-0">
            <div className={`font-semibold truncate ${m.available === false ? 'line-through text-zinc-500' : ''}`}>{m.item_name}</div>
            <div className="text-xs text-zinc-400">${Number(m.price).toFixed(2)} · {m.category}{m.available === false ? ' · hidden' : ''}</div>
          </div>
          <button className="text-xs px-2 py-1.5 rounded-lg bg-zinc-800" onClick={() => setForm(m)}>Edit</button>
          <button className="text-xs px-2 py-1.5 rounded-lg bg-zinc-800" onClick={() => toggle(m)}>{m.available === false ? 'Show' : 'Hide'}</button>
          <button className="text-xs px-2 py-1.5 rounded-lg bg-zinc-800 text-rose-300" onClick={() => remove(m)}>Delete</button>
        </div>
      ))}
      <button onClick={() => setForm({ ...blank })} className="w-full p-3 rounded-xl bg-zinc-200 text-black font-semibold">
        + Add item
      </button>
    </div>
  );
}
